# Backblaze B2 (required) — S3-compatible API
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Optional: public base URL for the bucket (only if it is public). Leave blank
# to stream every clip/snapshot through short-lived presigned URLs instead.
# B2_PUBLIC_URL=

# --- Frigate NVR (the detection engine) ---
# Base URL of a running Frigate instance. infra/frigate/ brings one up locally
# on :5000. The archive worker reads its HTTP API; it never runs detection.
FRIGATE_URL=http://localhost:5000
# RTSP/file input Frigate is watching (echoed in the UI/docs). For the bundled
# demo this is a looped file; point it at a real camera RTSP URL for live use.
# FRIGATE_RTSP_INPUT=rtsp://user:pass@camera.local:554/stream

# --- Archive worker (Frigate -> B2) ---
# Seconds between event polls when the worker runs in a loop.
ARCHIVE_POLL_INTERVAL_S=30

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001_EXAMPLE_application_key_value
# B2_BUCKET_NAME=my-nvr-archive
