{
  "name": "frigate-nvr-archive",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @frigate-nvr-archive/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @frigate-nvr-archive/web build",
    "typecheck": "pnpm --filter @frigate-nvr-archive/web typecheck",
    "lint": "pnpm --filter @frigate-nvr-archive/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @frigate-nvr-archive/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "@hono/node-server@<1.19.15": "1.19.15",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "express-rate-limit@>=8.2.0 <8.2.2": "8.2.2",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "flatted@<=3.4.1": "3.4.2",
      "hono@<4.12.34": "4.13.2",
      "hono@>=3.8.0 <4.12.34": "4.13.2",
      "hono@>=4.0.0 <4.12.34": "4.13.2",
      "hono@>=4.3.3 <4.12.34": "4.13.2",
      "hono@>=4.7.0 <4.12.34": "4.13.2",
      "hono@>=4.11.8 <4.12.34": "4.13.2",
      "ip-address@<=10.3.0": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "lodash@>=4.0.0 <=4.17.23": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.6",
      "nanoid@<3.3.18": "3.3.18",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.5",
      "postcss@<=8.5.22": "8.5.26",
      "postcss-selector-parser@>=7.1.0 <7.1.3": "7.1.3",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "shell-quote@<=1.8.4": "1.9.0"
    }
  }
}
